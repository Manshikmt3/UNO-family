{
  "name": "uno-arena-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "UNO Arena — Multiplayer & AI Card Game",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -n \"server,client\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=@uno-arena/server",
    "dev:client": "npm run dev --workspace=@uno-arena/client",
    "share": "npx localtunnel --port 5173",
    "build": "npm run build --workspace=@uno-arena/shared && npm run build --workspace=@uno-arena/game-engine && npm run build --workspace=@uno-arena/server && npm run build --workspace=@uno-arena/client",
    "test": "npm run test --workspaces --if-present",
    "test:engine": "npm run test --workspace=@uno-arena/game-engine",
    "test:server": "npm run test --workspace=@uno-arena/server",
    "test:client": "npm run test --workspace=@uno-arena/client",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "npm run build --workspace=@uno-arena/shared && npm run build --workspace=@uno-arena/game-engine"
  },
  "keywords": [
    "uno",
    "card-game",
    "multiplayer",
    "socket.io",
    "react",
    "typescript"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
